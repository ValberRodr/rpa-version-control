<Window
    x:Class="RpaVersionControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">
    <Grid>
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Auto"
                        PaneTitle="RPA Version Control"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Visão geral" Tag="dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projetos" Tag="projects">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Minhas alterações" Tag="mychanges">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="QaQueueItem" Content="Fila de QA" Tag="qa">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Accept"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Histórico" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8">
                    <TextBlock x:Name="UserNameText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UserRoleText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="RPA Version Control"
                        LeftClickCommand="{x:Bind ShowWindowCommand}"
                        NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="V"
                                        Background="#4F46E5"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="38"/>
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem Text="Abrir" Command="{x:Bind ShowWindowCommand}"/>
                    <MenuFlyoutItem Text="Atualizar" Command="{x:Bind RefreshCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Sair" Command="{x:Bind ExitCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
