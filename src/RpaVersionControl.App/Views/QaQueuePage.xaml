<Page
    x:Class="RpaVersionControl.App.Views.QaQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Fila de QA" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Revisões aguardando decisão e publicações que precisam ser retomadas."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="32" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Nenhuma revisão pendente" Style="{StaticResource EmptyStateStyle}" FontWeight="SemiBold"/>
            <TextBlock Text="Quando um desenvolvedor enviar uma alteração, ela aparecerá aqui para revisão."
                       Style="{StaticResource EmptyStateStyle}"/>
        </StackPanel>

        <ListView x:Name="QueueList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeveloperDisplayName}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding ChangeSummary}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="Revisar" Tag="{Binding Id}" Click="Review_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
