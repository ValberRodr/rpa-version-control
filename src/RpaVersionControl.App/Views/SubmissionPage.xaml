<Page
    x:Class="RpaVersionControl.App.Views.SubmissionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RpaVersionControl.App.Controls">
    <Grid Padding="{StaticResource PagePadding}" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer>
            <StackPanel Spacing="14">
                <TextBlock x:Name="TitleText" Text="Enviar nova versão" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="ProjectText" FontWeight="SemiBold"/>

                <TextBox x:Name="IncidentBox"
                         Header="Incidente / solicitação relacionada"
                         PlaceholderText="Ex.: INC-123456"/>
                <TextBox x:Name="ReasonBox"
                         Header="Motivo da alteração"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="72"/>
                <TextBox x:Name="SummaryBox"
                         Header="O que foi alterado"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="90"/>
                <TextBox x:Name="ImpactBox"
                         Header="Impacto esperado"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="72"/>

                <TextBox x:Name="FolderBox" Header="Pasta candidata" IsReadOnly="True"/>
                <Button Click="PickFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                        <TextBlock Text="Selecionar pasta desenvolvida"/>
                    </StackPanel>
                </Button>

                <InfoBar x:Name="PreviewInfo" IsOpen="False"/>

                <Button Style="{StaticResource AccentButtonStyle}" Click="Preview_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AB;" FontSize="13"/>
                        <TextBlock Text="Comparar com versão oficial"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SubmitButton" IsEnabled="False" Click="Submit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="13"/>
                        <TextBlock Text="Submeter para QA"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Prévia das alterações" FontSize="20" FontWeight="SemiBold"/>

            <ListView x:Name="FilesList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                                <Run Text="+" Foreground="{StaticResource SuccessBrush}"/>
                                <Run Text="{Binding LinesAdded}" Foreground="{StaticResource SuccessBrush}"/>
                                <Run Text=" −" Foreground="{StaticResource DangerBrush}"/>
                                <Run Text="{Binding LinesDeleted}" Foreground="{StaticResource DangerBrush}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:DiffViewer x:Name="Diff" Grid.Row="2"/>
        </Grid>
    </Grid>
</Page>
