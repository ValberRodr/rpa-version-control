<Page
    x:Class="RpaVersionControl.App.Views.MyChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Minhas alterações" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Acompanhe aprovações, retornos e versões publicadas."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE9D9;" FontSize="32" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Nenhuma alteração sua por aqui ainda" Style="{StaticResource EmptyStateStyle}" FontWeight="SemiBold"/>
            <TextBlock Text="Vá até Projetos e escolha 'Enviar nova versão' para submeter uma alteração à QA."
                       Style="{StaticResource EmptyStateStyle}"/>
        </StackPanel>

        <ListView x:Name="ChangesList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ChangeSummary}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="Abrir" Tag="{Binding Id}" Click="Open_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
