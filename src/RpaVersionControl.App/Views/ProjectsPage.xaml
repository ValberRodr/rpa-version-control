<Page
    x:Class="RpaVersionControl.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Projetos" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Cada projeto aponta para a pasta oficial e mantém um histórico próprio."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="NewProjectButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Cadastrar projeto"/>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B7;" FontSize="32" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Nenhum projeto cadastrado ainda" Style="{StaticResource EmptyStateStyle}" FontWeight="SemiBold"/>
            <TextBlock Text="Um administrador precisa cadastrar o primeiro projeto apontando para a pasta oficial em rede."
                       Style="{StaticResource EmptyStateStyle}"/>
        </StackPanel>

        <ListView x:Name="ProjectsList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OfficialPath}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="Versão atual: v"/>
                                    <Run Text="{Binding CurrentVersion}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Tag="{Binding Id}" Click="History_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE81C;" FontSize="13"/>
                                        <TextBlock Text="Histórico"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding Id}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="NewVersion_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE898;" FontSize="13"/>
                                        <TextBlock Text="Enviar nova versão"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
