<Page
    x:Class="RpaVersionControl.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Projetos" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Cada projeto aponta para a pasta oficial e mantém um histórico próprio."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="NewProjectButton"
                    Content="Cadastrar projeto"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="NewProject_Click"/>
        </Grid>

        <ListView x:Name="ProjectsList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OfficialPath}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="Versão atual: v"/>
                                    <Run Text="{Binding CurrentVersion}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Histórico" Tag="{Binding Id}" Click="History_Click"/>
                                <Button Content="Enviar nova versão"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="NewVersion_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
