<Page
    x:Class="RpaVersionControl.App.Views.QaReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RpaVersionControl.App.Controls">
    <Grid Padding="{StaticResource PagePadding}" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock x:Name="IdText" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="ProjectText" FontSize="18" FontWeight="SemiBold"/>
                <InfoBar x:Name="StatusInfo" IsOpen="True"/>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Informações do DEV" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeveloperText"/>
                        <TextBlock x:Name="IncidentText"/>
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ImpactText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ChecklistPanel" Spacing="10">
                    <TextBlock Text="Checklist de QA" FontSize="18" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="QuestionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Question}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <ComboBox SelectedIndex="{Binding AnswerIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Sim"/>
                                            <ComboBoxItem Content="Não"/>
                                        </ComboBox>
                                        <TextBox Header="Comentário — obrigatório para NÃO"
                                                 Text="{Binding Comment, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Solicitar ajustes / devolver"
                                Click="Return_Click"/>
                        <Button Content="Aprovar e publicar"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Approve_Click"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="RetryPublishButton"
                        Content="Retomar publicação"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed"
                        Click="RetryPublish_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Alterações submetidas" FontSize="20" FontWeight="SemiBold"/>
            <ListView x:Name="FilesList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Kind}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <controls:DiffViewer x:Name="Diff" Grid.Row="2"/>
        </Grid>
    </Grid>
</Page>
